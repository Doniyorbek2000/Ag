PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_BOOTSTRAP_EMAIL=admin@admai.uz
ADMIN_BOOTSTRAP_PASSWORD=change_me_on_first_login
DATABASE_PATH=./data/admai.sqlite

# Google Play purchase verification (optional -- see backend/README.md).
# Without these, purchases are trusted from the client receipt as-is.
# GOOGLE_PLAY_PACKAGE_NAME=com.admai.app
# GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=./google-play-service-account.json

# Click.uz merchant credentials (optional -- see backend/README.md).
# Without these, /api/payments/click/* responds with "not configured".
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=

# Payme (Paycom) merchant credentials (optional -- see backend/README.md).
# Without these, /api/payments/payme/* responds with "not configured".
# PAYME_MERCHANT_ID=
# PAYME_KEY=
